{
  "name": "hyperaxe",
  "description": "Enchanted hyperscript weapon.",
  "version": "3.0.0",
  "author": "Nate Goldman <ungoldman@gmail.com> (https://ungoldman.com/)",
  "bugs": {
    "url": "https://github.com/ungoldman/hyperaxe/issues"
  },
  "dependencies": {
    "html-tags": "^5.1.0",
    "hyperscript": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "tsx": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "default": "./dist/factory.js"
    },
    "./factory.js": {
      "types": "./dist/factory.d.ts",
      "default": "./dist/factory.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts"
  ],
  "homepage": "https://github.com/ungoldman/hyperaxe#readme",
  "keywords": [
    "dom",
    "factory",
    "html",
    "hyperscript",
    "sugar"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ungoldman/hyperaxe.git"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run lint:types && npm test && npx publint && npm run test:pack",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:types": "tsc --noEmit",
    "postrelease": "git push --follow-tags && npm publish",
    "prepare": "npm run build",
    "prerelease": "git fetch --tags && npm run check",
    "release": "npm version patch",
    "test": "node --test --import=tsx src/**/*.spec.ts",
    "test:pack": "bash scripts/test-pack.sh",
    "test:watch": "node --test --watch --import=tsx src/**/*.spec.ts"
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
